# ===== AI 模型配置（国内中转）=====
# 中转站签发的 API Key
OPENAI_API_KEY=
# 中转站地址，一般以 /v1 结尾
OPENAI_API_BASE_URL=
# 视觉识别模型名
OPENAI_VISION_MODEL=gpt-5.4-mini
# 图像编辑模型名
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high

# ===== 人像参考图 =====
# 放一张本人清晰正脸 PNG 到此路径
WARDROBE_MODEL_REFERENCE=data/model-reference.png

# ===== 天气服务（可选）=====
# 和风天气 API Key（免费开发者 key，https://dev.qweather.com）
# 未配置时定位模式自动回退 Open-Meteo（免 key）
QWEATHER_KEY=
# 和风 API 域名（免费版用 devapi，商业版用 api）
QWEATHER_HOST=devapi.qweather.com

# ===== 前端 API 地址（Capacitor 打包时用）=====
# 留空=同源；未来原生 App 指向远程服务地址
VITE_API_BASE_URL=
